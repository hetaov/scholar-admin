# ==================== CloudBase 配置 ====================
# CloudBase 环境 ID
TCB_ENV_ID=knowlege-graph-env-d7cwud346b70b

# 区域
TCB_REGION=ap-shanghai

# 腾讯云 API 密钥（CloudRun 部署时自动注入，本地开发需手动填写）
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
TENCENTCLOUD_SESSIONTOKEN=

# ==================== 火山引擎方舟模型配置 ====================
# 火山方舟 API Key（在 https://console.volcengine.com/ark 创建）
VOLCANO_API_KEY=

# 【重要】推理接入点 ID（Endpoint ID），不是模型名称！
# 创建步骤：控制台 → 在线推理 → 创建接入点 → 选 doubao-1.5-vision-pro-32k → 获得 ep-xxx
# 管理地址：https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
VOLCANO_VISION_MODEL=

# ==================== 混元（HUNYUAN）评估配置 ====================
# 说明：混元 Judge 走 OpenAI 兼容网关（Bearer API Key），与 config.py 中
# Bearer + /chat/completions 调用范式匹配；缺省回落的 TENCENTCLOUD_SECRETKEY
# 与默认 HUNYUAN_BASE_URL（hunyuan.tencentcloudapi.com，TC3 签名端点）均不可用于该范式，
# 会表现为「HTTP 200 + 无 choices」→ L3 全部 JUDGE_SKIPPED。
# 混元 OpenAI 兼容网关地址（在 https://console.cloud.tencent.com/hunyuan 开通后获取）
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# 混元控制台 API 密钥（密钥管理 → API 密钥；区别于腾讯云 SecretKey）
HUNYUAN_SECRET_KEY=
# 评分模型（默认 hunyuan-pro）
# HUNYUAN_EVAL_MODEL=hunyuan-pro
# 调用超时（秒，默认 60）
# HUNYUAN_TIMEOUT_SECONDS=60
# 通过阈值（score ≥ 该值计通过，默认 0.7）
# HUNYUAN_EVAL_PASS_THRESHOLD=0.7

# ==================== 服务配置 ====================
# 服务端口（默认 8080）
# PORT=8080

# ==================== AI 对话生成 v1（批量生成面 /ai/dialogue/v1）====================
# 设计稿：docs_v1/AI会话/AI英语对话生成设计.md
# 批量对话生成总开关（默认 0 关闭；本地调测置 1 开启）
# DIALOGUE_GEN_ENABLED=1
# 单次 LLM 调用超时（秒，默认 300）
# DIALOGUE_LLM_TIMEOUT_SECONDS=300
# 本地 NC2 语料目录（默认 data/nc2；相对路径按项目根解析，仅本地调试用，文件化落盘不写真实库）
# DIALOGUE_CORPUS_DIR=data/nc2
# 本地调试默认学者（读取 learners/<scholar_id>.json 的模拟指标）
# DIALOGUE_LOCAL_SCHOLAR_ID=scholar_debug_01

# ---------- T3 生成图 + 覆盖校验（§4.3）----------
# 生成图开关（默认 0 关闭）：置 1 → 走 LangGraph StateGraph（装载→提示→生成→覆盖校验
# →重试/降级→评估→落盘）；置 0 → 回退 T1 单函数直连生成（零侵入、逐断言不变）
# DIALOGUE_GEN_GRAPH_ENABLED=1
# 覆盖校验重试预算（默认 2）：校验不通过且 retry_count < 该值 → refine_prompt 重生成；
# 用尽 → 非对话形态降级。单任务 LLM 调用上限 = 1 + 本值
# DIALOGUE_GEN_MAX_RETRY=2
# 断点续写开关（默认 0 关闭，T4 / §4.3.1）：置 1 且生成图开启时接
# NoSQLCheckpointSaver（独立集合 ai_dialogue_checkpoint）；置 0 → 无 checkpoint，
# resume 回退整任务重跑（notes=resume_without_checkpoint）
# DIALOGUE_GEN_CHECKPOINT_ENABLED=0
# 生成域 checkpoint 集合（T4 / §4.3.1，默认 ai_dialogue_checkpoint；勿与会话面
# conversation_graph_checkpoint 混用）
# DIALOGUE_CHECKPOINT_COLLECTION=ai_dialogue_checkpoint

# ==================== 数学错题识别 Admin 调试干跑（api-contract §3.15）====================
# 设计稿：docs_v1/AI错题/数学AI错题识别-设计文档.md
# 实施拆分：docs_v1/AI错题/数学AI错题识别-任务拆分与断点.md（B01 步）
# 定位：管理台调试干跑面 POST /math/scan/debug/recognize；与生产错题扫描链路
# （/math/scan/upload → /math/scan/classify → /math/scan/{scan_id}/correct）严格隔离，
# 小程序零接线、生产接口零改动；开关关闭则路由不注册（main.py 条件注册）。
#
# 调试干跑总开关（默认 0 关闭，生产必须保持 0）：置 1 后 math_debug_router 才会被 include。
# 关闭时端点不存在（404），避免信息泄露。
# MATH_SCAN_DEBUG_ENABLED=0
#
# 管理台调试 token（请求头 X-Debug-Token 比对，hmac.compare_digest 防时序攻击）：
# AUTH_MODE=dev + 未配 token 时放行（本地调试）；生产必须配置强随机 token。
# 高敏凭据：仅在管理台环境注入，**不进代码库**；泄露等价于持有付费 AI 调用权。
# MATH_SCAN_DEBUG_TOKEN=
